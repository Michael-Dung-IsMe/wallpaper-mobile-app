# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database
POSTGRES_USER=wallpaper
POSTGRES_PASSWORD=password123
POSTGRES_DB=wallpaper_db
DATABASE_URL=postgres://wallpaper:password123@localhost:5432/wallpaper_db

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wallpaper-bucket
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-yourbucket.r2.dev

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_min_32_characters_for_security
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyz0123456789 # Hash bcrypt của 'admin123'